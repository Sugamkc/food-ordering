<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.foodordering">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodOrdering"
        tools:targetApi="31">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <!-- Authentication Pages -->
        <activity
            android:name=".Activity.Auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Auth.SignUpActivity"
            android:exported="false" />

        <!-- Existing App Activities -->
        <activity
            android:name=".Activity.Cart.KhaltiOfficialPaymentActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Cart.CartActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="foodpal" android:host="payment-success" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Activity.DetailsFoods.DetailsOfFoodsActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.ItemList.ItemListActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Favorite.FavoriteActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Order.OrderActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Chat.ChatActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Splash.BaseActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Activity.DashBoard.MainActivity"
            android:exported="true" />
    </application>

</manifest>
